/sites/default/files/2024-04/bachelier_en_informatique_version_2_dossier_complet.pdf#page=104","type":"Course unit","entity":"EPHEC","summary":"DBMS-ontwikkelingsproject","id":"projet-de-developpement-sgbd","courseUnit":true},{"name":"Bases des réseaux","keywords":["Ethernet","MAC","TCP/IP","Networking"],"url":"https://www.ephec.be/sites/default/files/2024-04/bachelier_en_informatique_version_2_dossier_complet.pdf#page=69","type":"Course unit","entity":"EPHEC","summary":"Netwerkbasis","id":"bases-des-reseaux","courseUnit":true},{"name":"Organisation des entreprises et éléments de management","keywords":["Management"],"url":"https://www.ephec.be/sites/default/files/2024-04/bachelier_en_informatique_version_2_dossier_complet.pdf#page=52","type":"Course unit","entity":"EPHEC","summary":"Bedrijfsorganisatie en management","id":"organisation-des-entreprises-et-elements-de-management","courseUnit":true},{"name":"Produits logiciels de gestion intégrés","keywords":["ERP"],"url":"https://www.ephec.be/sites/default/files/2024-04/bachelier_en_informatique_version_2_dossier_complet.pdf#page=61","type":"Course unit","entity":"EPHEC","summary":"Geïntegreerde beheersoftware","id":"produits-logiciels-de-gestion-integres","courseUnit":true},{"name":"Projet d'intégration de développement","keywords":["AJAX","JSON","XML","SQLInjection","XSS","Caching","URLRewriting"],"url":"https://www.ephec.be/sites/default/files/2024-04/bachelier_en_informatique_version_2_dossier_complet.pdf#page=108","type":"Course unit","entity":"EPHEC","summary":"Ontwikkelingsintegratieproject","id":"projet-d-integration-de-developpement","courseUnit":true},{"name":"Veille technologique","keywords":["TechWatch"],"url":"https://www.ephec.be/sites/default/files/2024-04/bachelier_en_informatique_version_2_dossier_complet.pdf#page=65","type":"Course unit","entity":"EPHEC","summary":"Technologiewatch","id":"veille-technologique","courseUnit":true},{"name":"Administration, gestion et sécurisation des réseaux","keywords":["NetworkAdministration","NetworkSecurity","ApplicationServer"],"url":"https://www.ephec.be/sites/default/files/2024-04/bachelier_en_informatique_version_2_dossier_complet.pdf#page=74","type":"Course unit","entity":"EPHEC","summary":"Netwerkbeheer en -beveiliging","id":"administration-gestion-et-securisation-des-reseaux","courseUnit":true},{"name":"Langue en situation appliquée à l'enseignement supérieur UE1","keywords":["ProfessionalCommunication"],"type":"Course unit","entity":"EPHEC","summary":"Toegepaste taal hoger onderwijs UE1","id":"langue-en-situation-appliquee-a-l-enseignement-superieur-ue1","courseUnit":true},{"name":"Langue en situation appliquée à l'enseignement supérieur UE2","keywords":["ProfessionalCommunication"],"url":"https://www.ephec.be/sites/default/files/2024-04/bachelier_en_informatique_version_2_dossier_complet.pdf#page=24","type":"Course unit","entity":"EPHEC","summary":"Toegepaste taal hoger onderwijs UE2","id":"langue-en-situation-appliquee-a-l-enseignement-superieur-ue2","courseUnit":true}],"references":[{"name":"Waseem Virk, Flutter-ontwikkelaar bij Emvi.ai","reference":"Samenwerken met Baptiste Grosjean aan het EMVI-project was een ongelooflijk verrijkende ervaring — zowel professioneel als persoonlijk. Baptiste is niet alleen een zeer bekwame ontwikkelaar met een scherp oog voor design en functionaliteit, maar hij is ook een mentor en inspiratiebron geweest tijdens onze samenwerking.\n\nIk heb enorm veel van hem geleerd — van best practices in Flutter-ontwikkeling tot het belang van doordachte UI/UX en clean architecture. Hij staat altijd klaar om zijn kennis te delen, complexe ideeën helder uit te leggen, en het team op elke mogelijke manier te ondersteunen.\n\nWat het meest opvalt is Baptistes vermogen om uitdagingen om te zetten in kansen. Zijn rustige, gefocuste aanpak en zijn probleemoplossende mindset hebben ons geholpen technische hindernissen te overwinnen en functies te bouwen die de gebruikerservaring echt verbeteren. Zijn collaboratieve aard maakte teamwerk soepel en motiverend.\n\nAls je iemand zoekt die niet alleen uitzonderlijke resultaten levert, maar ook iedereen om zich heen optilt, kan ik Baptiste niet genoeg aanbevelen. Hij is een fantastische ontwikkelaar, een geweldige teamgenoot, en iemand van wie ik het geluk heb gehad te mogen leren. — (vertaald uit het Engels)"},{"name":"Tino Schuerewegen, softwareontwikkelaar bij Xtrada","reference":"Ik heb het genoegen gehad om een jaar met Baptiste samen te werken, met de extra vreugde hem drie maanden te hebben mogen mentoren in een project. Als er één ding aan Baptiste opvalt, is het zijn grenzeloze energie. Of het nu 9 uur 's ochtends of 9 uur 's avonds is, hij is altijd de meest enthousiaste persoon in de kamer — soms zelfs enthousiaster dan het koffiezetapparaat.\n\nBaptiste brengt aanstekelijke energie in elk project waaraan hij deelneemt. Hij is extravert, slim, en heeft een leergierigheid die echt bewonderenswaardig is. Of hij nu in een complexe taak duikt of inzichtelijke vragen stelt, hij is altijd op zoek naar kennis. Zijn enthousiasme om te leren, vooral als het gaat om tools als ChatGPT, is zowel indrukwekkend als een beetje intimiderend. Serieus, als ChatGPT een beste vriend had, zou het Baptiste zijn!\n\nHij is ook ongelooflijk hands-on, schroomt nooit om de mouwen op te stropen en diep in het werk te duiken. Zijn aanpak is niet alleen theoretisch; het draait helemaal om praktische, tastbare resultaten.\n\nKortom, als je iemand zoekt die enthousiasme, intelligentie en een vleugje humor in elke taak brengt, is Baptiste je man. Met hem werken was niet alleen productief, maar oprecht plezierig. — (vertaald uit het Engels)"},{"name":"Emiel Van Gysegem, marketing en operations bij Xtra Groep","reference":"Hoewel we niet direct samenwerkten, had ik altijd een heel fijne connectie met Baptiste. In een mengelmoes van Engels, Nederlands en Frans deelden we vaak leuke gesprekken. Zijn enthousiasme en energie zijn echt aanstekelijk, en hij weet een prettige, informele sfeer te creëren in elke interactie. Baptiste is iemand die een positieve dynamiek met zich meebrengt."},{"name":"Steven Claus, CFO bij Xtra Groep","reference":"Baptiste is een full-stack softwareontwikkelaar gedreven door een onwankelbare vastberadenheid. Deze mindset doordringt elk aspect van zijn carrière. Hij heeft in verschillende domeinen gewerkt, waardoor hij zich snel aan elke situatie kan aanpassen. Deze rollen hebben zowel zijn technische als interpersoonlijke vaardigheden aangescherpt, waardoor hij een veelzijdige medewerker is die een significante impact heeft op elk project waaraan hij deelneemt. Gevoed door een constant verlangen om te leren, werkt hij zijn kennis voortdurend bij via een master in computerwetenschappen. Deze voortdurende leerreis maakt van hem een goed afgeronde IT-professional in het domein van computerwetenschappen. — (vertaald uit het Engels)"},{"name":"Tjörven Janssens, softwareontwikkelaar bij Xtrada","reference":"Baptiste is naast een software ontwikkelaar, graag bezig met data-analyse en is een expert in het gebruik van ChatGPT. Hij leert graag nieuwe dingen en doet dit ook snel. Hij is erg enthousiast in omgang en staat steeds klaar voor een vriendelijk woord of wat advies."},{"name":"Michael Culot, sales manager bij Xtrada","reference":"Baptiste is een geweldige en toegewijde ontwikkelaar die gretig is om nieuwe technologieën te blijven leren en zijn vaardigheden te verbeteren. Je zou verbaasd zijn over niet alleen zijn kennis, maar ook over zijn warme, open enthousiasme. Baptiste, je gaat geweldige dingen doen in je leven, blijf gewoon je levendige geest behouden ✊ — (vertaald uit het Engels)"}],"skills":[{"name":"HardSkills","keywords":["SQL","C#","Java","Python","JS","TS","XML","JSON","HTML","CSS","Zsh","Dart","Rust","LaTeX","SQL Server","EF",".NET","Pandas","NumPy","Whisper","SpaCy","PyTorch","Transformers","HuggingFace","SentenceTransformers","LLMs","RAG","LangChain","OpenAI","Claude","Embeddings","ColBERT","Reranking","FAISS","OpenSearch","RAGAS","PromptEngineering","OCR","Docling","VLM","Node.js","Express.js","Blazor","Angular","React","Flutter","Tokio","Axum","Tower","Gradle","NPM","JWT","Auth0","SSH","Venv","Conda","Docker","UML","Merise","VisualParadigm","MiniZinc","ConstraintProgramming","CombinatorialOptimization","Pareto","Lark","DSL","Hypothesis","CleanCode","CleanArchitecture","DDD","CQRS"]},{"name":"SoftSkills","keywords":["Adaptability","Resilience","Leadership","Creativity","Initiative","Analysis","Flexibility","Teamwork","Organization","Pragmatism","Resourcefulness","Thoroughness"]},{"name":"Learning","keywords":["TDD","TensorFlow","Scikit-Learn","C","XQuery","Blockchain"]}],"languages":[{"language":"Frans","fluency":"Moedertaal"},{"language":"Engels","fluency":"B1+/B2 (TOEIC 730 / ELAO)"},{"language":"Nederlands","fluency":"B1"}],"awards":[{"title":"TOEIC","date":"2023-06-06","awarder":"ETS","summary":"730"}],"interests":[{"name":"Onderzoek en ontwikkeling","keywords":["Innovations","Experimentation","POCs"]}],"volunteer":[{"organization":"UMons","position":"Studentenvertegenwoordiger","url":"https://www.umons.be","startDate":"2023-11-30","endDate":"2026-09-04","id":"umons-student-representative"},{"organization":"UMons","position":"Buddy TandeMons","url":"https://www.umons.be","startDate":"2023-11-30","endDate":"2026-09-04","id":"umons-buddy-tandemons"},{"organization":"EPHEC École Supérieure de Promotion Sociale","position":"Studentenvertegenwoordiger","url":"https://www.ephec.be","startDate":"2019-09-30","endDate":"2022-10-15","id":"ephec-ecole-superieure-de-promotion-sociale-student-representative"},{"organization":"EPHEC École Supérieure de Promotion Sociale","position":"Tutor","url":"https://www.ephec.be","startDate":"2019-09-30","endDate":"2022-10-15","id":"ephec-ecole-superieure-de-promotion-sociale-tutor"}],"competitions":[{"key":"HackathonCOW2024","title":"Hackathon Citizens of Wallonia 2024","date":"2024-03-17","organizer":"Citizens of Wallonia","summary":"EduCraft — oplossing waarmee iedereen een eigen gepersonaliseerd leerpad kan opstellen om nieuwe vaardigheden te verwerven.","url":"https://www.cow.be","projects":["EduCraft"],"id":"hackathon-citizens-of-wallonia-2024"},{"key":"HackathonCOW2023","title":"Hackathon Citizens of Wallonia 2023","date":"2023-03-31","organizer":"Citizens of Wallonia","summary":"OnlyTogether — oplossing die ervoor zorgt dat kwetsbare gebruikers altijd begeleid worden.","url":"https://www.cow.be","id":"hackathon-citizens-of-wallonia-2023"}]},"viewsTitle":"Weergaven","views":[{"id":"classic","href":"/nl/","label":"Klassiek"},{"id":"interactive","href":"/app/nl/","label":"Interactief"},{"id":"xsltRich","href":"/assets/data/resume-nl.xml","label":"XSLT (uitgebreid)","note":"best te bekijken in Firefox"},{"id":"xsltMinimal","href":"/assets/data/resume-nl-minimal.xml","label":"XSLT (minimaal)","note":"best te bekijken in Firefox"},{"id":"pdf","href":"/app/nl/pdf/","label":"PDF"},{"id":"timeline","href":"/app/nl/pdf/timeline/","label":"Tijdlijn (PDF)"}],"pictures":{"/assets/cv/cv_grosjean_baptiste_nl.pdf":[{"src":"/assets/cv/previews/cv_grosjean_baptiste_nl-1.webp","width":1000,"height":1415},{"src":"/assets/cv/previews/cv_grosjean_baptiste_nl-2.webp","width":1415,"height":1000}],"/assets/cv/cv_grosjean_baptiste_timeline_2y_nl.pdf":[{"src":"/assets/cv/previews/cv_grosjean_baptiste_timeline_2y_nl-1.webp","width":1000,"height":708}],"/assets/cv/cv_grosjean_baptiste_timeline_5y_nl.pdf":[{"src":"/assets/cv/previews/cv_grosjean_baptiste_timeline_5y_nl-1.webp","width":1000,"height":708}],"/assets/cv/cv_grosjean_baptiste_timeline_nl.pdf":[{"src":"/assets/cv/previews/cv_grosjean_baptiste_timeline_nl-1.webp","width":1000,"height":708}]}}
