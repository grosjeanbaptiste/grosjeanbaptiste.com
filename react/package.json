{
  "name": "grosjeanbaptiste-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "React view of the CV, served at /app/. Built into ../app and committed like the other generated views.",
  "scripts": {
    "data": "node scripts/export-data.mjs",
    "dev": "npm run data && vite",
    "build": "npm run data && tsc --noEmit && vite build && node scripts/route-pages.mjs",
    "test": "npm run data && vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cmdk": "^1.1.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
