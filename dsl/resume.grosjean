        }
        Remi {
            name "Remi"
            description t{ en: "Reminiscence application for people with cognitive issues.", fr: "Application de réminiscence pour personnes souffrant de troubles cognitifs.", nl: "Reminiscentie-applicatie voor mensen met cognitieve problemen.", es: "Aplicación de reminiscencia para personas con problemas cognitivos.", de: "Reminiszenz-App für Menschen mit kognitiven Problemen.", zh: "为认知障碍患者设计的追忆应用。" }
            summary t{ en: "Reminiscence application allowing people with cognitive issues to recover their memories through descriptions of their photos powered by facial recognition and LLMs. DeepFace by Serengil was used for the facial recognition pipeline.", fr: "Application de réminiscence permettant aux personnes souffrant de troubles cognitifs de retrouver leurs souvenirs via des descriptions de photos générées par reconnaissance faciale et LLMs. Pipeline DeepFace (Serengil).", nl: "Reminiscentie-applicatie waarmee mensen met cognitieve problemen hun herinneringen terugvinden via beschrijvingen van hun foto's, gevoed door gezichtsherkenning en LLMs. DeepFace (Serengil) pipeline.", es: "Aplicación de reminiscencia que permite a personas con problemas cognitivos recuperar sus recuerdos mediante descripciones de fotos generadas por reconocimiento facial y LLMs. Pipeline DeepFace (Serengil).", de: "Reminiszenz-Anwendung, die Menschen mit kognitiven Problemen ermöglicht, ihre Erinnerungen durch Beschreibungen ihrer Fotos mit Gesichtserkennung und LLMs wiederzuerlangen. DeepFace (Serengil) Pipeline.", zh: "追忆应用，让认知障碍患者通过基于面部识别和大模型生成的照片描述来恢复记忆。DeepFace (Serengil) 管道。" }
            keywords [Python, FastAPI, OpenAI, Whisper, DeepFace, PostgreSQL, SQLAlchemy]
            startDate 2024-10-01
            endDate 2025-06-30
            type t{ en: "AI Application", fr: "Application d'IA", nl: "AI-applicatie", es: "Aplicación de IA", de: "KI-Anwendung", zh: "人工智能应用" }
        }
        EduCraft {
            name "EduCraft"
            description t{ en: "Platform allowing users to get more skills.", fr: "Plateforme permettant à chacun d'acquérir de nouvelles compétences.", nl: "Platform waarmee iedereen nieuwe vaardigheden kan verwerven.", es: "Plataforma que permite a cualquiera adquirir nuevas competencias.", de: "Plattform für den Erwerb neuer Fähigkeiten.", zh: "让任何人都能获得新技能的平台。" }
            keywords [PHP, API, "UI/UX"]
            startDate 2024-03-29
            endDate 2024-03-31
        }
        MyWay {
            name "MyWay"
            description t{ en: "Education manager for students. No longer maintained; database and auth are unavailable.", fr: "Gestionnaire de parcours éducatif pour étudiants. Plus maintenu ; la base de données et l'auth sont indisponibles.", nl: "Studieplanner voor studenten. Niet langer onderhouden; database en authenticatie zijn niet beschikbaar.", es: "Gestor educativo para estudiantes. Sin mantenimiento; la base de datos y la autenticación no están disponibles.", de: "Bildungsmanager für Studierende. Nicht mehr gepflegt; Datenbank und Auth sind nicht verfügbar.", zh: "学生教育管理工具。不再维护；数据库和身份验证不可用。" }
            keywords [Angular, JavaScript, TypeScript, "Express.js", API, "UI/UX", "SQL Server", Auth0, PayPal, Sequelize, "Node.js", React]
            startDate 2023-01-01
